<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "full"/Touch flavor only - Handheld doesn't declare this at all,
         so it can never request or receive it. Confirmed on-device (before
         a later revert of unrelated work) that this fixes raw file access
         for hypseus's own code and third-party libraries it bundles
         (Singe's zip loader, plog's logger) that bypass the app's own
         file-access code entirely. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

</manifest>
